# ---------------------------------------------------------------------------
# MySubaru account
# ---------------------------------------------------------------------------
# The email and password you use at https://www.mysubaru.com
SUBARU_USERNAME=you@example.com
SUBARU_PASSWORD=your-mysubaru-password

# The 4-digit PIN configured in your STARLINK account. Every remote command
# requires it — a wrong PIN fails the command, it does not fail the login.
SUBARU_PIN=0000

# ---------------------------------------------------------------------------
# Vehicle
# ---------------------------------------------------------------------------
# Numeric key identifying the vehicle on your account. OPTIONAL: login succeeds
# without it and the command payloads never reference it, so a single-vehicle
# account can leave it blank. Set it to pick a specific car when you have more
# than one. `npm run cli -- discover` finds it.
SUBARU_VEHICLE_KEY=0000000

# Vehicle VIN. Used to build the serviceRequestId when polling command status.
SUBARU_VIN=XXXXXXXXXXXXXXXXX

# REQUIRED. The trusted-device token for two-factor auth — not an arbitrary id.
# A fresh or missing value redirects login to /multiFactorAuthentication.html
# and no session is established. Copy it from the login request payload in your
# browser's Network tab.
SUBARU_DEVICE_ID=1700000000000

# ---------------------------------------------------------------------------
# HTTP service (only needed for `npm start`)
# ---------------------------------------------------------------------------
# Shared secret callers must send as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
API_TOKEN=change-me-to-a-long-random-string

PORT=3000

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# How long to poll for a command to finish before giving up.
# POLL_TIMEOUT_MS=120000
# POLL_INTERVAL_MS=2000
